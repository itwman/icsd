# این فایل را به .env کپی کنید و مقادیر را پر کنید.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
# روی سرور: CSRF_TRUSTED_ORIGINS=https://icsd.ir,https://www.icsd.ir

# ── دیتابیس ── خالی بگذارید تا SQLite استفاده شود
# POSTGRES_DB=icsd
# POSTGRES_USER=icsd
# POSTGRES_PASSWORD=strong-password
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432

# ── پیامک ── console: کد در ترمینال چاپ می‌شود
SMS_PROVIDER=console
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=

# ── زرین‌پال ──
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=True
